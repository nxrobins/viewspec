  "state": [
    {"id":"escalation_guide_visible","kind":"scalar","scope":"app","initial":{"value":false}},
    {"id":"reviewed_count","kind":"scalar","scope":"app","initial":{"value":0}},
    {"id":"intake_paused","kind":"scalar","scope":"app","initial":{"value":false}}
  ],
  "mutations": [
    {
      "id":"reveal_escalation_guide",
      "trigger":{"action_id":"show_escalation_guide","screen_id":"dispatch"},
      "ops":[{"op":"set","state":"escalation_guide_visible","value":true}]
    },
    {
      "id":"increment_reviewed_count",
      "trigger":{"action_id":"record_review","screen_id":"dispatch"},
      "ops":[{"op":"increment","state":"reviewed_count"}]
    },
    {
      "id":"pause_dispatch_intake",
      "trigger":{"action_id":"pause_intake","screen_id":"dispatch"},
      "ops":[{"op":"set","state":"intake_paused","value":true}]
    }
  ],
  "selectors": [],
  "visibility": [
    {"id":"show_escalation_panel","screen_id":"dispatch","target_ref":"motif:escalation_panel","when":{"state":"escalation_guide_visible","is":"truthy"}},
    {"id":"show_review_count","screen_id":"dispatch","target_ref":"motif:review_count_panel","when":{"state":"reviewed_count","is":"truthy"}},
    {"id":"show_intake_paused","screen_id":"dispatch","target_ref":"motif:intake_paused_panel","when":{"state":"intake_paused","is":"truthy"}}
  ],
  "state_replay_assertions": [
    {
      "id":"escalation_guide_replay",
      "events":[{"mutation_id":"reveal_escalation_guide"}],
      "expect_state":{"escalation_guide_visible":true},
      "expect_visibility":{"show_escalation_panel":true}
    },
    {
      "id":"review_count_replay",
      "events":[{"mutation_id":"increment_reviewed_count"},{"mutation_id":"increment_reviewed_count"}],
      "expect_state":{"reviewed_count":2},
      "expect_visibility":{"show_review_count":true}
    },
    {
      "id":"pause_intake_replay",
      "events":[{"mutation_id":"pause_dispatch_intake"}],
      "expect_state":{"intake_paused":true},
      "expect_visibility":{"show_intake_paused":true}
    }
  ]
