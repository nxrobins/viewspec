      "id":"show_escalation_guide_replay",
      "events":[{"mutation_id":"reveal_escalation_guide"}],
      "expect_state":{"escalation_guide_visible":true,"reviewed_count":0,"intake_paused":false},
      "expect_visibility":{"show_escalation_panel":true,"show_review_count":false,"show_intake_paused":false}
    },
    {
      "id":"record_review_once_replay",
      "events":[{"mutation_id":"increment_reviewed_count"}],
      "expect_state":{"escalation_guide_visible":false,"reviewed_count":1,"intake_paused":false},
      "expect_visibility":{"show_escalation_panel":false,"show_review_count":true,"show_intake_paused":false}
    },
    {
      "id":"record_review_twice_replay",
      "events":[{"mutation_id":"increment_reviewed_count"},{"mutation_id":"increment_reviewed_count"}],
      "expect_state":{"escalation_guide_visible":false,"reviewed_count":2,"intake_paused":false},
      "expect_visibility":{"show_escalation_panel":false,"show_review_count":true,"show_intake_paused":false}
    },
    {
      "id":"pause_intake_replay",
      "events":[{"mutation_id":"pause_dispatch_intake"}],
