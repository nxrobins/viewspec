      "expect_selectors":{
        "maya_workload_jobs":[{"id":"J-204","technician":"Maya Chen"}],
        "owen_workload_jobs":[{"id":"J-205","technician":"Owen Park"}],
        "lena_workload_jobs":[{"id":"J-206","technician":"Lena Ortiz"},{"id":"J-207","technician":"Lena Ortiz"},{"id":"J-208","technician":"Lena Ortiz"},{"id":"J-209","technician":"Lena Ortiz"},{"id":"J-210","technician":"Lena Ortiz"},{"id":"J-211","technician":"Lena Ortiz"}]
      },
      "expect_visibility":{"show_escalation_panel":false,"show_review_count":false,"show_intake_paused":true}
    }
