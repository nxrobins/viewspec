      "presentation": {
        "profile": "operations_workspace",
        "rules": [
          {
            "id": "workspace_shell",
            "target_ref": "region:workspace",
            "base": {"display":"grid","areas":[["sidebar","main"]],"columns":["rail_lg","fluid"],"gap":"none","padding":"none"},
            "variants": {
              "compact": {"areas":[["sidebar"],["main"]],"columns":1},
              "medium": {"areas":[["sidebar"],["main"]],"columns":1},
              "wide": {"areas":[["sidebar","main"]],"columns":["rail_lg","fluid"]}
            }
          },
          {
            "id": "sidebar_panel",
            "target_ref": "region:sidebar",
            "base": {"display":"flex","direction":"column","gap":"md","padding":"xl","sticky":true,"background":"sidebar"},
            "variants": {"compact":{"padding":"sm","gap":"xs","sticky":false},"medium":{"padding":"lg","sticky":false},"wide":{"sticky":true}}
          },
          {
            "id": "main_content",
            "target_ref": "region:main",
            "base": {"display":"flex","direction":"column","gap":"xl","padding":"xl","min_inline_size":"zero","background":"canvas"},
            "variants": {"compact":{"padding":"lg","gap":"sm"},"medium":{"padding":"2xl"},"wide":{"padding":"xl"}}
          },
          {
            "id": "dispatch_hero_layout",
            "target_ref": "motif:page_hero",
