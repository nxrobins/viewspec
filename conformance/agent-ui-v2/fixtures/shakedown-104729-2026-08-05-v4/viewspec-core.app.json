            "variants": {"compact":{"columns":["fluid","auto"],"gap":"sm"},"medium":{"columns":["fluid","auto"],"gap":"md"}}
          },
          {
            "id": "summary_strip_layout",
            "target_ref": "motif:summary_metrics",
