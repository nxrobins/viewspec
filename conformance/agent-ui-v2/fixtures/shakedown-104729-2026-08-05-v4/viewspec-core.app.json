  "visibility": [
    {"id":"show_escalation_panel","screen_id":"dispatch","target_ref":"motif:escalation_panel","when":{"state":"escalation_guide_visible","is":"truthy"}},
    {"id":"show_review_count","screen_id":"dispatch","target_ref":"motif:review_count_panel","when":{"state":"reviewed_count","is":"truthy"}},
    {"id":"show_intake_paused","screen_id":"dispatch","target_ref":"motif:intake_paused_panel","when":{"state":"intake_paused","is":"truthy"}},
