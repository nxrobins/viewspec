            "variants": {"compact":{"columns":3,"gap":"sm"},"medium":{"columns":3,"gap":"md"},"wide":{"columns":3,"gap":"md"}}
          },
          {
            "id": "attention_job_layout",
            "target_ref": "motif:attention_job_list",
            "base": {"display":"block","padding":"none","min_inline_size":"zero","background":"transparent","border":"none","radius":"none"},
            "variants": {},
            "items": {
              "base": {"display":"grid","columns":["identity_lg","fluid_wide","fluid","auto"],"gap":"sm","padding":"lg","min_inline_size":"zero","background":"surface","border":"subtle","radius":"md"},
              "variants": {
                "compact": {"columns":["identity_sm","fluid","auto"],"gap":"xs","padding":"md"},
                "medium": {"columns":["identity_md","fluid_wide","auto"],"gap":"md","padding":"md"},
                "wide": {"columns":["identity_lg","fluid_wide","fluid","auto"]}
              }
            }
          },
          {
            "id": "attention_header_layout",
            "target_ref": "motif:attention_header",
            "base": {"display":"flex","direction":"row","align":"center","gap":"sm","padding":"none","width":"intrinsic","background":"transparent","border":"none","radius":"none"},
            "variants": {}
          },
          {
            "id": "queue_header_layout",
            "target_ref": "motif:queue_header",
            "base": {"display":"block","padding":"none","width":"intrinsic","background":"transparent","border":"none","radius":"none"},
            "variants": {}
          },
          {
            "id": "route_job_layout",
            "target_ref": "motif:route_job_list",
            "base": {"display":"block","padding":"none","min_inline_size":"zero","background":"transparent","border":"none","radius":"none"},
            "variants": {},
            "items": {
              "base": {"display":"grid","columns":["identity_lg","fluid_wide","fluid","auto"],"gap":"sm","padding":"lg","min_inline_size":"zero","background":"surface","border":"subtle","radius":"md"},
              "variants": {
                "compact": {"columns":["identity_sm","fluid","auto"],"gap":"xs","padding":"md"},
                "medium": {"columns":["identity_md","fluid_wide","auto"],"gap":"md","padding":"md"},
                "wide": {"columns":["identity_lg","fluid_wide","fluid","auto"]}
              }
            }
          },
          {
            "id": "eyebrow_text",
            "target_ref": "binding:page_eyebrow",
            "base": {"area":"header_eyebrow","font_size":"caption","font_weight":"bold","foreground":"muted","letter_spacing":"wide","text_transform":"uppercase"},
            "variants": {}
          },
          {
            "id": "dispatch_title_text",
            "target_ref": "binding:page_title",
            "base": {"area":"header_title","font_family":"serif","font_size":"display_lg","font_weight":"medium","foreground":"ink","letter_spacing":"tight","line_height":"tight","min_inline_size":"zero","text_wrap":"normal","width":"intrinsic"},
            "variants": {"compact":{"font_size":"display_sm"},"medium":{"font_size":"display_sm"}}
