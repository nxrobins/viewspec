  "state": [
    {"id":"reviewed_count","kind":"scalar","scope":"app","initial":{"value":0}},
    {"id":"escalation_guide_visible","kind":"scalar","scope":"screen","screen_id":"dispatch","initial":{"value":false}},
    {"id":"intake_paused","kind":"scalar","scope":"screen","screen_id":"dispatch","initial":{"value":false}}
