    {"id":"review_one_job","events":[{"mutation_id":"increment_reviewed_count"}],"expect_state":{"reviewed_count":1},"expect_visibility":{"show_review_count":true}},
    {"id":"review_two_jobs","events":[{"mutation_id":"increment_reviewed_count"},{"mutation_id":"increment_reviewed_count"}],"expect_state":{"reviewed_count":2},"expect_visibility":{"show_review_count":true}},
    {"id":"reveal_guide","events":[{"mutation_id":"reveal_escalation_guide"}],"expect_state":{"escalation_guide_visible":true},"expect_visibility":{"show_escalation_panel":true}},
    {"id":"pause_dispatch_intake","events":[{"mutation_id":"pause_intake_state"}],"expect_state":{"intake_paused":true},"expect_visibility":{"show_intake_paused":true}}
  ]
