              "base":{"display":"grid","columns":["identity_lg","fluid_wide","fluid","auto"],"gap":"sm","padding":"lg","min_inline_size":"zero"},
              "variants":{
                "compact":{"display":"grid","columns":["identity_sm","fluid","auto"],"gap":"xs","padding":"md","min_inline_size":"zero"},
                "medium":{"display":"grid","columns":["identity_md","fluid_wide","auto"],"gap":"md","padding":"md","min_inline_size":"zero"},
                "wide":{"display":"grid","columns":["identity_lg","fluid_wide","fluid","auto"],"gap":"sm","padding":"lg","min_inline_size":"zero"}
