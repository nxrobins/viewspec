  "mutations": [
    {"id":"increment_reviewed_count","trigger":{"action_id":"record_review","screen_id":"dispatch"},"ops":[{"op":"increment","state":"reviewed_count"}]},
    {"id":"reveal_escalation_guide","trigger":{"action_id":"show_escalation_guide","screen_id":"dispatch"},"ops":[{"op":"set","state":"escalation_guide_visible","value":true}]},
    {"id":"pause_intake_state","trigger":{"action_id":"pause_intake","screen_id":"dispatch"},"ops":[{"op":"set","state":"intake_paused","value":true}]}
  ],
  "selectors": [],
  "visibility": [
    {"id":"show_escalation_panel","screen_id":"dispatch","target_ref":"motif:escalation_panel","when":{"state":"escalation_guide_visible","is":"truthy"}},
    {"id":"show_review_count","screen_id":"dispatch","target_ref":"motif:review_count_status","when":{"state":"reviewed_count","is":"truthy"}},
    {"id":"show_intake_paused","screen_id":"dispatch","target_ref":"motif:intake_paused_status","when":{"state":"intake_paused","is":"truthy"}}
