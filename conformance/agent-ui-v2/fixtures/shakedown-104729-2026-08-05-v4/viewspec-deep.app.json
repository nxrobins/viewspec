                "compact":{"display":"grid","columns":1,"gap":"xs","width":"full","min_inline_size":"zero"},
                "medium":{"display":"grid","columns":3,"gap":"sm","width":"full","min_inline_size":"zero"},
                "wide":{"display":"grid","columns":3,"gap":"sm","width":"full","min_inline_size":"zero"}
