    "required_mutation_classes": [
      "action-state-transition",
      "numeric-invariant",
      "visibility-contract",
      "resource-binding",
      "text-layout"
    ],
    "negative_control_trials_per_session": 2,
    "mutation_reset_policy": "restore-the-same-healthy-hash-before-each-trial",
    "reporting": "outcome-vector-and-pareto-frontier"
  },
  "success_criteria": {
    "minimum_functional_acceptance": 1.0,
    "minimum_layout_fidelity": 0.6769,
