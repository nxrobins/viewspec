  "tasks": [
    {
      "id": "field-dispatch-lifecycle",
      "title": "Field Dispatch Lifecycle",
      "brief": "Build and evolve the responsive field-service dispatch system shown in the attached reference. Preserve its visual character, semantics, behavior, and established contracts through every cumulative change. No network requests or remote assets are allowed.",
