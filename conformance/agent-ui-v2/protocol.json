    "thread_policy": "continue-lifecycle-thread",
    "cost_accounting": "total-and-post-establishment"
  },
  "study_design": {
    "thesis": "ViewSpec earns a bounded compute premium through quality parity, stronger durability and assurance, and reusable equivalent targets.",
    "pairing": "task-and-seed",
    "arm_order": "randomized-within-pair",
    "calibration_sessions_per_arm": 3,
    "confirmatory_tasks": 6,
    "confirmatory_replicates_per_task": 3,
    "phases": ["establishment", "evolution", "leverage", "assurance", "repair", "qualification"],
