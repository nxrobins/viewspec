        "Field Dispatch",
        "Unassigned",
        "J-204",
        "J-205",
        "J-206",
        "Needs attention",
        "J-207"
      ],
      "steps": [
        {
          "id": "establish-baseline",
          "phase": "establishment",
          "assurance_tags": ["visual-baseline", "semantic-structure"],
          "prompt": "Create the initial interface. It needs a Field Dispatch heading, a Tuesday · July 22 eyebrow, summary metrics for 3 Unassigned and 1 At risk, and jobs J-204, J-205, and J-206. J-204 is a Harbor Clinic HVAC inspection assigned to Maya Chen. J-205 is a North Terminal refrigeration sensor job assigned to Owen Park. J-206 is a Ridge School safety inspection assigned to Maya Chen. Match the supplied desktop reference closely and make the document structurally semantic.",
          "acceptance": {
            "required_text": [
              "Field Dispatch",
              "Tuesday · July 22",
              "Unassigned",
              "At risk",
              "J-204",
              "Harbor Clinic",
              "Maya Chen",
              "J-205",
              "North Terminal",
              "Owen Park",
              "J-206",
              "Ridge School"
            ],
            "forbidden_text": ["J-207", "Needs attention"],
            "required_buttons": [],
            "text_order": ["Field Dispatch", "Unassigned", "J-204", "J-205", "J-206"]
          }
        },
        {
