{
  "schema_version": 2,
  "id": "viewspec-agent-ui-value-premium-v2.2",
  "evaluation_mode": "value_premium",
  "primary_arm": "viewspec-deep",
  "model": "gpt-5.6-sol",
  "seeds": [104729, 130363, 155921],
  "arms": ["code-first", "viewspec-core", "viewspec-deep"],
  "minimum_sessions_per_arm": 18,
  "qualification": {
    "max_turns_per_arm": 2,
    "trigger": "post-lifecycle-ineligible-or-layout-miss",
