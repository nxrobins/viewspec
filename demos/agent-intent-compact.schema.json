  "$id": "https://viewspec.dev/agent-intent-compact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The compact authoring form of a ViewSpec IntentBundle: ViewSpecBuilder calls as JSON. ViewSpec normalizes it into the canonical IntentBundle before validation and compilation.",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/action"
      },
      "maxItems": 64,
      "type": "array"
    },
    "aesthetic": {
      "enum": [
        "aesthetic.calm_ops",
        "aesthetic.premium_saas",
        "aesthetic.data_dense",
        "aesthetic.editorial_product",
        "aesthetic.executive_review",
        "aesthetic.brutalist",
        "aesthetic.neon_cyber",
        "aesthetic.warm_organic"
      ]
    },
    "format": {
      "const": "compact",
      "description": "Marks the compact form. Canonical bundles have no format key."
    },
    "id": {
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/input"
      },
      "maxItems": 200,
      "type": "array"
    },
    "motifs": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/motif_table"
          },
          {
            "$ref": "#/$defs/motif_dashboard"
          },
          {
            "$ref": "#/$defs/motif_outline"
          },
          {
            "$ref": "#/$defs/motif_comparison"
          },
          {
            "$ref": "#/$defs/motif_list"
          },
          {
            "$ref": "#/$defs/motif_form"
          },
          {
            "$ref": "#/$defs/motif_detail"
          },
          {
            "$ref": "#/$defs/motif_empty_state"
          },
          {
            "$ref": "#/$defs/motif_loading_state"
          },
          {
            "$ref": "#/$defs/motif_error_state"
          },
          {
            "$ref": "#/$defs/motif_hero"
          }
        ]
      },
      "maxItems": 32,
      "type": "array"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/region"
      },
      "maxItems": 32,
      "type": "array"
    },
    "root": {
      "additionalProperties": false,
      "properties": {
        "max_children": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "min_children": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "description": "Optional IntentBundle schema version. Documents without schema_version are schema version 1.",
      "type": "integer"
    },
    "styles": {
      "items": {
        "$ref": "#/$defs/style"
      },
      "maxItems": 400,
      "type": "array"
    },
    "title": {
      "not": {
        "type": "null"
      }
    }
  },
  "required": [
    "format",
    "id"
  ],
  "title": "ViewSpec Agent IntentBundle Compact Form",
  "type": "object",
  "x-viewspec-compact-item-keys": {
    "comparison": "items",
    "dashboard": "cards",
    "detail": "fields",
    "form": "fields",
    "list": "items",
    "outline": "items",
    "table": "rows"
  },
  "x-viewspec-intent-schema-versions": [
    1
  ],
  "x-viewspec-invariants": [
    "A compact document normalizes to the canonical IntentBundle that the same ViewSpecBuilder calls export.",
    "Derived item ids are <motif>_<row|card|field|item|branch>_<n>, counting every item of the motif.",
    "Without regions, the bundle has the root region and a main region; with regions, root plus the listed ones.",
    "Motifs, inputs, styles, the aesthetic profile and actions normalize in that order.",
    "Every id must be unique within its kind, and node and binding ids must not collide.",
    "Action payload entries name field or input ids, which bind to <id>_value, or binding ids.",
    "bulk_action is not available in the compact form.",
    "Unknown keys are rejected instead of silently ignored.",
    "The canonical validator runs on the normalized bundle; its issues keep canonical $.view_spec paths."
  ]
}
