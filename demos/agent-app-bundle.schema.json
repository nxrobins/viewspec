{
  "$defs": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "kind": {
          "enum": [
            "internal_tool"
          ]
        },
        "root_route": {
          "maxLength": 96,
          "pattern": "^/[A-Za-z0-9_.~\\-/]*$",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/safe_string"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "root_route"
      ],
      "type": "object"
    },
    "app_bundle_v1": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "schema_version": {
          "const": 1
        },
        "screens": {
          "items": {
            "$ref": "#/$defs/screen_v1"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "app",
        "routes",
        "resources",
        "screens"
      ],
      "type": "object"
    },
    "app_bundle_v2": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        },
        "resource_binding": {
          "const": "fixture_readonly_v0"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "schema_version": {
          "const": 2
        },
        "screens": {
          "items": {
            "$ref": "#/$defs/screen_v2"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "resource_binding",
        "app",
        "routes",
        "resources",
        "screens"
      ],
      "type": "object"
    },
    "app_bundle_v3": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        },
        "interactive_state": {
          "const": "interactive_state_v0"
        },
        "mutations": {
          "$ref": "#/$defs/state_mutations"
        },
        "resource_binding": {
          "const": "fixture_readonly_v0"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "schema_version": {
          "const": 3
        },
        "screens": {
          "items": {
            "$ref": "#/$defs/screen_v2"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "selectors": {
          "$ref": "#/$defs/state_selectors"
        },
        "state": {
          "$ref": "#/$defs/state_entries"
        },
        "state_replay_assertions": {
          "$ref": "#/$defs/state_replay_assertions"
        }
      },
      "required": [
        "schema_version",
        "resource_binding",
        "interactive_state",
        "app",
        "routes",
        "resources",
        "screens",
        "state",
        "mutations",
        "selectors"
      ],
      "type": "object"
    },
    "app_bundle_v4": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        },
        "interactive_state": {
          "const": "interactive_state_v0"
        },
        "mutations": {
          "$ref": "#/$defs/state_mutations"
        },
        "resource_binding": {
          "const": "fixture_readonly_v0"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "schema_version": {
          "const": 4
        },
        "screens": {
          "items": {
            "$ref": "#/$defs/screen_v2"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "selectors": {
          "$ref": "#/$defs/state_selectors"
        },
        "state": {
          "$ref": "#/$defs/state_entries"
        },
        "state_replay_assertions": {
          "$ref": "#/$defs/state_replay_assertions_v4"
        },
        "state_text": {
          "$ref": "#/$defs/state_text_rules"
        },
        "visibility": {
          "$ref": "#/$defs/visibility_rules"
        }
      },
      "required": [
        "schema_version",
        "resource_binding",
        "interactive_state",
        "app",
        "routes",
        "resources",
        "screens",
        "state",
        "mutations",
        "selectors"
      ],
      "type": "object"
    },
    "fixture_record": {
      "additionalProperties": {
        "anyOf": [
          {
            "maxLength": 2048,
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxProperties": 32,
      "propertyNames": {
        "maxLength": 96,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "type": "object"
    },
    "intent_bundle": {
      "description": "Embedded local V1 IntentBundle. validate-app/prove-app enforce the full local V1 validator.",
      "type": "object"
    },
    "json_scalar": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "json_value": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/json_value"
          },
          "maxItems": 100,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          },
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "type": "object"
        }
      ]
    },
    "payload_expr": {
      "anyOf": [
        {
          "$ref": "#/$defs/json_value"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from_payload": {
              "$ref": "#/$defs/safe_id"
            }
          },
          "required": [
            "from_payload"
          ],
          "type": "object"
        }
      ]
    },
    "presentation": {
      "additionalProperties": false,
      "description": "Shared static/React layout contract. operations_workspace keeps sibling sidebar/main regions visible, stacks them at compact/medium, and uses a wide rail/content row.",
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/presentation_anchor"
          },
          "maxItems": 64,
          "type": "array"
        },
        "profile": {
          "enum": [
            "neutral",
            "operations_workspace",
            "editorial_dashboard"
          ]
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/presentation_rule"
          },
          "maxItems": 96,
          "type": "array"
        }
      },
      "type": "object"
    },
    "presentation_anchor": {
      "additionalProperties": false,
      "description": "Responsive semantic geometry assertion. Scope viewports to widths where the relation is true; a rail/content same_row relation is normally wide-only when compact and medium stack.",
      "properties": {
        "anchor_ref": {
          "$ref": "#/$defs/presentation_target_ref"
        },
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "relation": {
          "enum": [
            "inside",
            "before",
            "after",
            "aligned_start",
            "aligned_center",
            "same_row"
          ]
        },
        "target_ref": {
          "$ref": "#/$defs/presentation_target_ref"
        },
        "viewports": {
          "items": {
            "enum": [
              "compact",
              "medium",
              "wide"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "target_ref",
        "relation",
        "anchor_ref"
      ],
      "type": "object"
    },
    "presentation_item_layout": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/presentation_layout"
        },
        "variants": {
          "additionalProperties": false,
          "properties": {
            "compact": {
              "$ref": "#/$defs/presentation_layout"
            },
            "medium": {
              "$ref": "#/$defs/presentation_layout"
            },
            "wide": {
              "$ref": "#/$defs/presentation_layout"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "presentation_layout": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "area": {
          "$ref": "#/$defs/safe_id"
        },
        "areas": {
          "items": {
            "items": {
              "$ref": "#/$defs/safe_id"
            },
            "maxItems": 4,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "background": {
          "enum": [
            "transparent",
            "canvas",
            "surface",
            "sidebar",
            "subtle",
            "accent",
            "danger_subtle"
          ]
        },
        "border": {
          "enum": [
            "none",
            "subtle",
            "strong"
          ]
        },
        "columns": {
          "oneOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "items": {
                "enum": [
                  "auto",
                  "fluid",
                  "fluid_wide",
                  "content_sm",
                  "content_md",
                  "identity_sm",
                  "identity_md",
                  "identity_lg",
                  "rail_sm",
                  "rail_md",
                  "rail_lg"
                ]
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array"
            }
          ]
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ]
        },
        "display": {
          "enum": [
            "block",
            "flex",
            "grid",
            "none"
          ]
        },
        "font_family": {
          "enum": [
            "sans",
            "serif",
            "mono"
          ]
        },
        "font_size": {
          "enum": [
            "caption",
            "small",
            "body",
            "title",
            "display_sm",
            "display_lg"
          ]
        },
        "font_weight": {
          "enum": [
            "regular",
            "medium",
            "semibold",
            "bold",
            "black"
          ]
        },
        "foreground": {
          "enum": [
            "ink",
            "muted",
            "inverse",
            "accent",
            "danger"
          ]
        },
        "gap": {
          "enum": [
            "none",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl",
            "3xl"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "between",
            "stretch"
          ]
        },
        "letter_spacing": {
          "enum": [
            "tight",
            "normal",
            "wide"
          ]
        },
        "line_height": {
          "enum": [
            "tight",
            "snug",
            "normal",
            "relaxed"
          ]
        },
        "max_lines": {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "max_width": {
          "enum": [
            "auto",
            "full",
            "intrinsic",
            "content_sm",
            "content_md",
            "content_lg",
            "rail_sm",
            "rail_md",
            "rail_lg"
          ]
        },
        "min_inline_size": {
          "enum": [
            "zero",
            "content"
          ]
        },
        "order": {
          "maximum": 16,
          "minimum": -16,
          "type": "integer"
        },
        "padding": {
          "enum": [
            "none",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl",
            "3xl"
          ]
        },
        "radius": {
          "enum": [
            "none",
            "sm",
            "md",
            "pill"
          ]
        },
        "span": {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "sticky": {
          "type": "boolean"
        },
        "text_transform": {
          "enum": [
            "none",
            "uppercase"
          ]
        },
        "text_wrap": {
          "enum": [
            "normal",
            "anywhere",
            "no_wrap"
          ]
        },
        "visibility": {
          "enum": [
            "visible",
            "hidden"
          ]
        },
        "width": {
          "enum": [
            "auto",
            "full",
            "intrinsic",
            "content_sm",
            "content_md",
            "content_lg",
            "rail_sm",
            "rail_md",
            "rail_lg"
          ]
        }
      },
      "type": "object"
    },
    "presentation_rule": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/presentation_layout"
        },
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "items": {
          "$ref": "#/$defs/presentation_item_layout"
        },
        "target_ref": {
          "$ref": "#/$defs/presentation_target_ref"
        },
        "variants": {
          "additionalProperties": false,
          "properties": {
            "compact": {
              "$ref": "#/$defs/presentation_layout"
            },
            "medium": {
              "$ref": "#/$defs/presentation_layout"
            },
            "wide": {
              "$ref": "#/$defs/presentation_layout"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "target_ref"
      ],
      "type": "object"
    },
    "presentation_target_ref": {
      "pattern": "^(region|motif|binding):[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "resource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "kind": {
          "enum": [
            "fixture"
          ]
        },
        "records": {
          "items": {
            "$ref": "#/$defs/fixture_record"
          },
          "maxItems": 100,
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "records"
      ],
      "type": "object"
    },
    "resource_repeat": {
      "additionalProperties": false,
      "description": "Generates every declared record-field binding inside the target motif. Do not also keep hand-authored prototype bindings for repeated record-fields in that motif.",
      "properties": {
        "field_presentations": {
          "items": {
            "$ref": "#/$defs/resource_repeat_field_presentation"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "group_id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "required": [
        "field_presentations"
      ],
      "type": "object"
    },
    "resource_repeat_field_presentation": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/safe_id"
        },
        "present_as": {
          "enum": [
            "badge",
            "label",
            "text",
            "value"
          ]
        }
      },
      "required": [
        "field",
        "present_as"
      ],
      "type": "object"
    },
    "resource_view": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/safe_id"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "mode": {
          "const": "list"
        },
        "record_ids": {
          "items": {
            "$ref": "#/$defs/safe_id"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "repeat": {
          "$ref": "#/$defs/resource_repeat"
        },
        "resource_id": {
          "$ref": "#/$defs/safe_id"
        },
        "target_motif_id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "required": [
        "id",
        "resource_id",
        "mode",
        "record_ids",
        "fields",
        "target_motif_id"
      ],
      "type": "object"
    },
    "resource_view_ref": {
      "additionalProperties": false,
      "properties": {
        "screen_id": {
          "$ref": "#/$defs/safe_id"
        },
        "view_id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "required": [
        "screen_id",
        "view_id"
      ],
      "type": "object"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/resource"
      },
      "maxItems": 8,
      "type": "array"
    },
    "route": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "label": {
          "$ref": "#/$defs/safe_string"
        },
        "path": {
          "maxLength": 96,
          "pattern": "^/[A-Za-z0-9_.~\\-/]*$",
          "type": "string"
        },
        "screen_id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "required": [
        "id",
        "path",
        "label",
        "screen_id"
      ],
      "type": "object"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/route"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "safe_id": {
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "safe_string": {
      "maxLength": 2048,
      "type": "string"
    },
    "screen_v1": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "intent_bundle": {
          "$ref": "#/$defs/intent_bundle"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "title": {
          "$ref": "#/$defs/safe_string"
        }
      },
      "required": [
        "id",
        "title",
        "intent_bundle"
      ],
      "type": "object"
    },
    "screen_v2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "intent_bundle": {
          "$ref": "#/$defs/intent_bundle"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "resource_views": {
          "items": {
            "$ref": "#/$defs/resource_view"
          },
          "maxItems": 8,
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/safe_string"
        }
      },
      "required": [
        "id",
        "title",
        "resource_views",
        "intent_bundle"
      ],
      "type": "object"
    },
    "selector_op_filter_eq": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/safe_id"
        },
        "op": {
          "const": "filter_eq"
        },
        "value": {
          "$ref": "#/$defs/json_value"
        }
      },
      "required": [
        "op",
        "field",
        "value"
      ],
      "type": "object"
    },
    "selector_op_slice": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "slice"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "selector_op_sort_by": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "field": {
          "$ref": "#/$defs/safe_id"
        },
        "op": {
          "const": "sort_by"
        }
      },
      "required": [
        "op",
        "field"
      ],
      "type": "object"
    },
    "state_entries": {
      "items": {
        "$ref": "#/$defs/state_entry"
      },
      "maxItems": 32,
      "type": "array"
    },
    "state_entry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "initial": {
          "$ref": "#/$defs/state_initial"
        },
        "kind": {
          "enum": [
            "collection",
            "record",
            "scalar",
            "selection"
          ]
        },
        "scope": {
          "enum": [
            "app",
            "screen"
          ]
        },
        "screen_id": {
          "$ref": "#/$defs/safe_id"
        }
      },
      "required": [
        "id",
        "kind",
        "scope",
        "initial"
      ],
      "type": "object"
    },
    "state_initial": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "value": {
              "$ref": "#/$defs/json_value"
            }
          },
          "required": [
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from_resource_view": {
              "$ref": "#/$defs/resource_view_ref"
            }
          },
          "required": [
            "from_resource_view"
          ],
          "type": "object"
        }
      ]
    },
    "state_mutation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "ops": {
          "items": {
            "$ref": "#/$defs/state_mutation_op"
